# Copy this file to .env and set the paths for your machine.
CODE_ROOT=$HOME/Code
SYMPHONY_REPO_ROOT=$CODE_ROOT/symphony
SYMPHONY_ELIXIR_ROOT=$SYMPHONY_REPO_ROOT/elixir
SYMPHONY_WORKSPACES_ROOT=$CODE_ROOT/.symphony-workspaces
SYMPHONY_WORKSPACE_ROOT=$SYMPHONY_WORKSPACES_ROOT/your-workspace
SYMPHONY_JJ_REPO=/path/to/staging-jj-repository
SYMPHONY_JJ_SOURCE_REPO=$SYMPHONY_JJ_REPO
SYMPHONY_REPO_CONFIG=$SYMPHONY_ELIXIR_ROOT/symphony-repos.json
SYMPHONY_ELIGIBILITY_SCRIPT=$SYMPHONY_ELIXIR_ROOT/scripts/symphony_eligibility.py
SYMPHONY_STATE_DIR=$SYMPHONY_WORKSPACES_ROOT/.symphony-state
SYMPHONY_LOGS_ROOT=$CODE_ROOT/.symphony-logs
SYMPHONY_PRODUCER_ROOT=$SYMPHONY_WORKSPACES_ROOT/producers
SYMPHONY_REVIEWER_ROOT=$SYMPHONY_WORKSPACES_ROOT/reviewers
CODEX_BIN=$HOME/.local/bin/codex
SYMPHONY_READONLY_WORKSPACES=

# Repository-specific values referenced by symphony-repos.json.
PRF_JJ_REPO=/path/to/project-staging-jj-repository
PRF_PRODUCER_ROOT=$SYMPHONY_WORKSPACES_ROOT/project-producers
PRF_REVIEWER_ROOT=$SYMPHONY_WORKSPACES_ROOT/project-reviewers
PRF_EVM_JJ_REPO=/path/to/evm-jj-repository
PRF_SITE_JJ_REPO=/path/to/site-jj-repository
PROTOCOL_DEPLOYMENTS_JJ_REPO=/path/to/deployments-jj-repository
PRF_REPO_PRODUCER_ROOT=$SYMPHONY_WORKSPACES_ROOT/project-producers
PRF_REPO_REVIEWER_ROOT=$SYMPHONY_WORKSPACES_ROOT/project-reviewers
PRF_EVM_ROOT=/path/to/evm-project
SEW_SIMULATION_ROOT=/path/to/simulation-project
SEW_SIMULATION_JJ_ROOT=$SEW_SIMULATION_ROOT/.jj
SEW_SIMULATION_GIT_ROOT=$SEW_SIMULATION_ROOT/.git
CLJ_TOOLS_JAR=$HOME/.deps.clj/path/to/clojure-tools.jar

# Set Linear credentials outside this file or add them locally; never commit them.
# LINEAR_API_KEY=
